{
  "name": "initialize-container",
  "image": "node:20",
  "workspaceFolder": "/app",
  "mounts": [
    {
      "source": "/d/Docker/docker-initialize",
      "target": "/app",
      "type": "bind"
    },
    {
      "source": "my-node-modules",
      "target": "/app/node_modules",
      "type": "volume"
    }
  ],
  "runArgs": ["--name", "initialize-container", "-p", "5000:5000", "--rm"],
  "postCreateCommand": "npm install"
}
